# Variables d'environnement — HASHCODE Community Portal
# Copie ce fichier vers .env.local et remplis les valeurs

# Base de données (Neon, Supabase, ou PostgreSQL local)
# Utilisée par lib/db.ts (pool applicatif)
DATABASE_URL=postgresql://user:password@localhost:5432/hashcode

# Connexion directe (sans pool) — requise par drizzle-kit (drizzle.config.ts)
# Exemple Neon : postgresql://user:password@ep-xxx.neon.tech/hashcode?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/hashcode

# Auth / Sécurité
# Secret JWT (min 32 caractères) — requis par lib/edge-auth.ts, lib/auth.ts, middleware.ts
JWT_SECRET=remplace-moi-par-une-chaine-aleatoire-de-32-chars-min
# URL publique de l'app — utilisée pour les magic links (lib/auth.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (optionnel — pour magic links et notifications)
# Clé API Resend — requise pour l'envoi d'emails (lib/auth.ts, app/api/test-email/route.ts)
RESEND_API_KEY=
# Nom d'expéditeur affiché — utilisé dans lib/auth.ts et app/api/test-email/route.ts
RESEND_FROM_NAME=HashCode
RESEND_FROM_EMAIL=noreply@hashcode.local

# Admin
# Email bootstrap admin (accès initial) — lib/auth.ts, app/api/auth/session/route.ts, app/api/members/me/route.ts
ADMIN_EMAIL=admin@hashcode.local

# Rate limiting (Redis) — lib/rate-limit.ts
# En dev : optionnel (fallback mémoire). En prod : requis (une paire suffit).
# Paire Upstash standard :
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=remplace-moi-par-le-token-upstash
# Alias Vercel KV (alternative à la paire Upstash) :
KV_REST_API_URL=https://xxx.kv.vercel-storage.com
KV_REST_API_TOKEN=remplace-moi-par-le-token-vercel-kv
# Note : lib/rate-limit.ts:87 référence UPSTASH_REDIS_REST_API_URL (variante avec _API,
# probable typo de UPSTASH_REDIS_REST_URL) — ne pas ajouter, à harmoniser dans le code.

# Logs (optionnel — lib/logger.ts, défaut 'info')
# Exemples : debug, info, warn, error
LOG_LEVEL=info
